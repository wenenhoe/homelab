exclude_paths:
    - .config/.pre-commit-config.yaml
    - .pre-commit-config.yaml
    - docker/
    - ansible/roles/molecule_helpers/fixtures/
    - ansible/roles/bind9/molecule/default/host_vars/
    - ansible/roles/lldap_bootstrap/molecule/default/host_vars/
    - ansible/roles/tinyauth/molecule/default/host_vars/
    - ansible/roles/lldap_cert/molecule/default/host_vars/
    - ansible/roles/lldap_cert/molecule/renewal_timing/host_vars/
    - ansible/roles/tinyauth_ca_trust/molecule/default/host_vars/
kinds:
    # backup_agent's default scenario splits verify.yml into several
    # files, each imported via import_tasks from verify.yml's own play
    # (docs/molecule-testing.md) — plain task lists, not standalone
    # playbooks, so ansible-lint's default playbook-shaped parsing for
    # anything under molecule/ needs an explicit override here.
    - tasks: "ansible/roles/backup_agent/molecule/default/verify_*.yml"
