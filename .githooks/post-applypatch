#!/usr/bin/env bash
# `git am` commits its own tree, so the views pre-applypatch regenerated are still uncommitted
# here. Fold them into the commit that was just made; its checks already passed.
set -euo pipefail

views=()
list="$(git rev-parse --show-toplevel)/.githooks/generated-views"
if [ -f "$list" ]; then
  while IFS= read -r view; do
    [ -z "$view" ] || git check-ignore -q -- "$view" || views+=("$view")
  done < "$list"
fi
# A view that is git-ignored is never committed, so with none left there is nothing to fold in.
if [ "${#views[@]}" -gt 0 ] && ! git diff --quiet HEAD -- "${views[@]}"; then
  git add -- "${views[@]}"
  git commit --amend --no-edit --no-verify --quiet
fi
