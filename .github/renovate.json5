{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    // Age/Adoption/Passing/Confidence badges on PRs. Only covers the go,
    // npm, maven, pypi, nuget, packagist and rubygems datasources
    // (docs.renovatebot.com/merge-confidence) — of this repo's managers,
    // only pep621/uv (pypi) qualifies; docker and ansible PRs won't show
    // badges. No extra token needed: badges load client-side in the browser.
    "mergeConfidence:all-badges",
  ],
  gitAuthor: "wenenhoe <33289235+wenenhoe@users.noreply.github.com>",

  // Reads GitHub's native Dependabot alerts (needs the "Dependabot
  // alerts" permission on RENOVATE_TOKEN — NOT "Dependabot version
  // updates", which would directly compete with Renovate for the same
  // job, or "Dependabot security updates", which would race Renovate's
  // own fix PR for the same CVE) plus OSV.dev for broader coverage.
  // Bypasses the Monday-only schedule and Dependency Dashboard approval
  // gate for anything flagged — a known CVE shouldn't sit until the next
  // cron run. Deliberately NOT automerged: same reasoning as the
  // pin/pinDigest carve-out earlier — the fix is still a real version
  // bump to a real dependency, same trust profile as any other
  // manual-review update, urgency isn't a reason to skip review here.
  vulnerabilityAlerts: {
    enabled: true,
    dependencyDashboardApproval: false,
    labels: ["security"],
    semanticCommitType: "chore",
    semanticCommitScope: "security",
  },
  osvVulnerabilityAlerts: true,

  timezone: "Asia/Singapore",
  // Cron syntax (recommended over the deprecated @breejs/later syntax,
  // e.g. the old "before 6am on monday"). Gates new branch/PR *creation*
  // only — see the cadence comment in .github/workflows/renovate.yml for
  // how this interacts with the (now-daily) workflow run schedule.
  // Minutes must be "*" — Renovate cron has no minute granularity.
  schedule: ["* 0-5 * * 1,4"],

  semanticCommits: "enabled",
  semanticCommitType: "chore",
  semanticCommitScope: "deps",

  // Renovate's default (2) queues anything beyond the first 2 new PRs in
  // a run to the next scheduled run instead of opening them same-day.
  // Redundant here: `schedule` above already gates *when* new PRs can
  // open (Mon/Thu only), and packageRules grouping already gates *how
  // many* a run produces — an hourly cap on top just adds multi-day
  // delay for updates that are already batched and already infrequent.
  prHourlyLimit: 0,

  // The pre-commit manager is disabled by default upstream — must opt in
  // explicitly. Its default file pattern (^|/)\.pre-commit-config\.ya?ml$
  // already matches .config/.pre-commit-config.yaml (anchored on
  // filename, not path), so no pattern override needed here.
  "pre-commit": {
    enabled: true,
  },

  // backup_agent's compose file, and now several docker/<app>/ ones too
  // (bind9, kms, lldap, minecraft, seaweedfs, step-ca — see
  // docs/topics/deploy/adding-an-app.md), are Jinja2 templates (compose.yaml.j2) with
  // static, non-interpolated image: lines — Renovate can parse them
  // fine, it just never looks at .j2 files by default. This pattern is
  // additive to the manager's built-in default, not a replacement.
  "docker-compose": {
    managerFilePatterns: ["/(^|/)(?:docker-)?compose[^/]*\\.ya?ml\\.j2$/"],
  },

  // Enabled by default in Renovate 43+, set explicitly anyway — this is
  // what keeps uv.lock's *transitive* pins current (direct deps already
  // get their own update-lockfile PRs, see the pep621/uv packageRule).
  // schedule is set explicitly because lockFileMaintenance has its own
  // independent default ("before 4am on monday") that the top-level
  // `schedule` above does not override.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["* 0-5 * * 1,4"],
  },

  // Tracks the renovate-version pin in .github/workflows/renovate.yml —
  // that string controls which ghcr.io/renovatebot/renovate image tag
  // actually gets pulled and run with RENOVATE_TOKEN's write access.
  // Deliberately NOT in the automerge packageRule below: this is Renovate
  // updating its own execution engine, the one component with a real
  // write credential — give every bump at least a glance rather than
  // rubber-stamping it alongside routine lint-hook version bumps.
  // The CodeRabbit CLI publishes no release list; releases/latest/VERSION is
  // its only version endpoint, a plain-text body holding the current release
  // (ADR 0063). format: plain reads that body as one release.
  customDatasources: {
    "coderabbit-cli": {
      defaultRegistryUrlTemplate: "https://cli.coderabbit.ai/releases/latest/VERSION",
      format: "plain",
    },

    // rclone's and OpenBao's releases carry a "v" tag and a large asset per
    // platform, which github-release-attachments would download whole to hash.
    // GitHub lists a sha256 `digest` on every asset it stores, so these read
    // the release list and return the digest of the one pinned asset beside
    // each version, tag's "v" removed. A release whose asset has no digest
    // (GitHub returns `null` for assets stored before it computed them) is
    // returned without one: passing that null to $substringAfter fails the
    // whole list, so no version resolves. The request needs the host rule
    // that renovate.yml sets: a custom datasource is not given the platform
    // token.
    "rclone-linux-amd64": {
      defaultRegistryUrlTemplate: "https://api.github.com/repos/rclone/rclone/releases?per_page=100",
      format: "json",
      transformTemplates: [
        '{"sourceUrl": "https://github.com/rclone/rclone", "releases": $map($[draft = false and prerelease = false], function($r) { {"version": $substringAfter($r.tag_name, "v"), "releaseTimestamp": $r.published_at, "digest": ($d := $r.assets[name = "rclone-" & $r.tag_name & "-linux-amd64.zip"].digest; $type($d) = "string" ? $substringAfter($d, "sha256:"))} })}',
      ],
    },
    "openbao-linux-amd64-deb": {
      defaultRegistryUrlTemplate: "https://api.github.com/repos/openbao/openbao/releases?per_page=100",
      format: "json",
      transformTemplates: [
        '{"sourceUrl": "https://github.com/openbao/openbao", "releases": $map($[draft = false and prerelease = false], function($r) { {"version": $substringAfter($r.tag_name, "v"), "releaseTimestamp": $r.published_at, "digest": ($d := $r.assets[name = "openbao_" & $substringAfter($r.tag_name, "v") & "_linux_amd64.deb"].digest; $type($d) = "string" ? $substringAfter($d, "sha256:"))} })}',
      ],
    },
  },

  customManagers: [
    {
      customType: "regex",
      description: "Keep the pinned Renovate execution image (renovate-version input) current",
      managerFilePatterns: ["/^\\.github/workflows/renovate\\.ya?ml$/"],
      matchStrings: ["renovate-version:\\s*[\"'](?<currentValue>[^\"']+)[\"']"],
      datasourceTemplate: "docker",
      depNameTemplate: "ghcr.io/renovatebot/renovate",
      versioningTemplate: "docker",
    },

    // The four entries below share one root cause: an image pin sitting
    // in a systemd unit template, a shell script, or a plain Ansible
    // variable default — none of which docker-compose/dockerfile/ansible
    // (the managers already active here) ever look inside. Found while
    // chasing why cloud_sync's rclone pin wasn't getting bump PRs; the
    // same blind spot turned out to apply to three other pins too.
    {
      customType: "regex",
      description: "cloud_sync's pinned rclone image, embedded in a systemd ExecStart= line rather than a compose file",
      managerFilePatterns: ["/^ansible/roles/cloud_sync/templates/cloud-sync\\.service\\.j2$/"],
      matchStrings: ["rclone/rclone:(?<currentValue>[0-9.]+)"],
      datasourceTemplate: "docker",
      depNameTemplate: "rclone/rclone",
    },
    {
      customType: "regex",
      description: "backup_agent's pinned rclone image, embedded in a shell script's docker run line rather than a compose file",
      managerFilePatterns: ["/^ansible/roles/backup_agent/templates/check-freshness\\.sh\\.j2$/"],
      matchStrings: ["rclone/rclone:(?<currentValue>[0-9.]+)"],
      datasourceTemplate: "docker",
      depNameTemplate: "rclone/rclone",
    },
    {
      customType: "regex",
      description: "step_ca_cert's step-cli image, a plain Ansible variable default rather than a recognized image: key under a docker module",
      managerFilePatterns: ["/^ansible/roles/step_ca_cert/defaults/main\\.ya?ml$/"],
      matchStrings: ["step_ca_cert_step_cli_image:\\s*[\"'](?<depName>[^:\"']+):(?<currentValue>[^\"']+)[\"']"],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "seed-lldap-ci-cert.sh's step-ca/step-cli/alpine images, shell variables rather than a recognized image: key",
      managerFilePatterns: ["/^\\.github/scripts/seed-lldap-ci-cert\\.sh$/"],
      matchStrings: [
        "step_ca_image=[\"'](?<depName>[^:\"']+):(?<currentValue>[^\"']+)[\"']",
        "step_cli_image=[\"'](?<depName>[^:\"']+):(?<currentValue>[^\"']+)[\"']",
        "alpine_image=[\"'](?<depName>[^:\"']+):(?<currentValue>[^\"']+)[\"']",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Images the Molecule playbooks run directly (molecule_helpers/vars/images/, one file per image), variable defaults rather than image: keys under tasks/",
      managerFilePatterns: ["/^ansible/roles/molecule_helpers/vars/images/[a-z_]+\\.ya?ml$/"],
      matchStrings: ["molecule_helpers_[a-z_]+_image:\\s*[\"'](?<depName>[^:\"']+):(?<currentValue>[^\"']+)[\"']"],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "volume-file-rm.yaml's throwaway alpine image, a play variable rather than a tasks/ file the ansible manager reads",
      managerFilePatterns: ["/^ansible/playbooks/volume-file-rm\\.ya?ml$/"],
      matchStrings: ["volume_rm_image:\\s*[\"'](?<depName>[^:\"']+):(?<currentValue>[^\"']+)[\"']"],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "openbao's pinned image, a plain Ansible variable default rather than a recognized image: key under a docker module",
      managerFilePatterns: ["/^ansible/roles/openbao/defaults/main\\.ya?ml$/"],
      matchStrings: ["openbao_image:\\s*[\"'](?<depName>[^:\"']+):(?<currentValue>[^\"']+)[\"']"],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "openbao's chown-image pin for cert post-issuance/renewal, a plain Ansible variable passed at include_role rather than a recognized image: key under a docker module",
      managerFilePatterns: ["/^ansible/playbooks/deploy\\.yaml$/"],
      matchStrings: ["step_ca_cert_chown_image:\\s*[\"'](?<depName>[^:\"']+):(?<currentValue>[^\"']+)[\"']"],
      datasourceTemplate: "docker",
    },
    // openbao_cli's native-CLI version and the sha256 of its .deb, a GitHub
    // release asset rather than a Docker Hub image, so it has its own
    // datasource. The pin is bare ("2.7.1") and the tag "v2.7.1"; the datasource
    // strips the "v". depNameTemplate matches the docker-datasourced
    // "openbao/openbao" pins so this joins their group rule below. The two
    // variables sit apart in the file, with the .deb's name and URL between.
    {
      customType: "regex",
      description: "openbao_cli's native-CLI version and the sha256 of its .deb, a GitHub release asset rather than a recognized image: key under a docker module",
      managerFilePatterns: ["/^ansible/roles/openbao_cli/defaults/main\\.ya?ml$/"],
      matchStrings: ["openbao_cli_version:\\s*[\"'](?<currentValue>[^\"']+)[\"'][\\s\\S]*?openbao_cli_deb_sha256:\\s*[\"'](?<currentDigest>[a-f0-9]{64})[\"']"],
      datasourceTemplate: "custom.openbao-linux-amd64-deb",
      depNameTemplate: "openbao/openbao",
    },
    // The CD agent's uv pin: a GitHub release asset, version and sha256 in two
    // adjacent Ansible variable defaults. uv's release tags are bare
    // ("0.12.23"), so no extractVersionTemplate. The attachments datasource
    // finds the pinned tarball's hash in the release's small .sha256 asset
    // and reads the same file from the new release, so one PR moves both.
    {
      customType: "regex",
      description: "cd_agent's uv version and the sha256 of its release tarball, a GitHub release asset rather than a recognized image: key under a docker module",
      managerFilePatterns: ["/^ansible/roles/cd_agent/defaults/main\\.ya?ml$/"],
      matchStrings: ["cd_agent_uv_version:\\s*[\"'](?<currentValue>[^\"']+)[\"']\\s+cd_agent_uv_sha256:\\s*[\"'](?<currentDigest>[a-f0-9]{64})[\"']"],
      datasourceTemplate: "github-release-attachments",
      depNameTemplate: "astral-sh/uv",
    },
    // The CD agent's native rclone pin, the same kind of pin as uv's: version
    // and the sha256 of linux-amd64.zip in adjacent variables. Its depName is
    // the image pins' own, so the group rule below moves it with them.
    {
      customType: "regex",
      description: "cd_agent's native rclone version and the sha256 of its release zip, a GitHub release asset rather than a recognized image: key under a docker module",
      managerFilePatterns: ["/^ansible/roles/cd_agent/defaults/main\\.ya?ml$/"],
      matchStrings: ["cd_agent_rclone_version:\\s*[\"'](?<currentValue>[^\"']+)[\"']\\s+cd_agent_rclone_sha256:\\s*[\"'](?<currentDigest>[a-f0-9]{64})[\"']"],
      datasourceTemplate: "custom.rclone-linux-amd64",
      depNameTemplate: "rclone/rclone",
    },
    {
      customType: "regex",
      description: "The CodeRabbit CLI version pinned in the review image's Dockerfile; only the version, not its hash",
      managerFilePatterns: ["/^tools/coderabbit-review/Dockerfile$/"],
      matchStrings: ["ARG CODERABBIT_VERSION=(?<currentValue>\\S+)"],
      datasourceTemplate: "custom.coderabbit-cli",
      depNameTemplate: "coderabbit-cli",
    },
    {
      customType: "regex",
      description: "The mermaid-cli image check_mermaid.py renders diagrams with, a Python constant rather than a recognized image: key",
      managerFilePatterns: ["/^tools/doc_scripts/check_mermaid\\.py$/"],
      matchStrings: ["MERMAID_CLI_IMAGE = \"(?<depName>[^:\"]+):(?<currentValue>[^\"]+)\""],
      datasourceTemplate: "docker",
    },
  ],

  packageRules: [
    // Pure local dev tooling — no production impact, and none of it
    // automerges beyond the pin/pinDigest case below anyway, so every
    // real bump needs a manual click regardless. Grouped into one PR:
    // six individual one-line version-bump PRs is pure friction for
    // updates this low-stakes, and if a grouped bump ever does break
    // something, it's still trivial to bisect (revert the group, re-add
    // hooks one at a time).
    {
      matchManagers: ["pre-commit"],
      automerge: false,
      semanticCommitScope: "ci",
      groupName: "pre-commit hooks",
    },

    // GitHub Actions deliberately NOT grouped, unlike pre-commit above —
    // different trust tier.
    {
      matchManagers: ["github-actions"],
      automerge: false,
      semanticCommitScope: "ci",
    },

    // The ONE thing that's actually safe to automerge in this category:
    // helpers:pinGitHubActionDigests's initial conversion of a tag ref to
    // a SHA (`actions/checkout@v6.1.0` → `actions/checkout@<sha> # v6.1.0`).
    // This introduces no new code — it pins the exact commit already
    // running today, nothing to review.
    //
    // Deliberately NOT extending this to ordinary version bumps: once an
    // action is SHA-pinned, the *next* update Renovate proposes is moving
    // that pin to a different commit when the upstream tag moves — and
    // automerging that PR would hand code execution (with RENOVATE_TOKEN's
    // write access) to whatever that new commit contains, without a human
    // ever looking at it. SHA-pinning only protects you if the PR that moves
    // the pin gets reviewed; automerging it defeats the point of having pinned
    // in the first place.
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["pin", "pinDigest"],
      automerge: true,
      automergeType: "pr",
    },

    // Same reasoning as the "docker images (minor/patch)" group below:
    // unrelated actions' minor/patch bumps carry the same low-risk profile
    // as unrelated docker minor/patch bumps. Majors stay individual (own
    // changelog read, own revert). Doesn't touch automerge — inherits
    // automerge:false from the blanket github-actions rule above.
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "github actions (minor/patch)",
      groupSlug: "github-actions-minor-patch",
    },

    // The renovate-version input in renovate.yml is extracted by both the
    // regex manager above and the github-actions manager (depType
    // uses-with), from the same line — so each new tag opened two PRs,
    // chore(deps) and chore(ci). The regex manager stays the only tracker
    // because tools/ci/images/remote.py builds the image inventory from
    // customManagers. The `uses: renovatebot/github-action@…` line is a
    // different dep and stays tracked.
    {
      matchManagers: ["github-actions"],
      matchDepTypes: ["uses-with"],
      matchPackageNames: ["ghcr.io/renovatebot/renovate"],
      enabled: false,
    },

    // Everything that actually touches deployed infra — compose files,
    // inline image: refs in Ansible tasks, the Caddy Dockerfile, Ansible
    // Galaxy collections — stays manual-review. These get applied to hosts
    // by hand via ansible-playbook, so there's no automated rollout to gate
    // anyway.
    {
      matchManagers: ["docker-compose", "dockerfile", "ansible", "ansible-galaxy"],
      automerge: false,
    },

    // pyproject.toml/uv.lock: one rule, not two. automerge:false lives here
    // (same manual-review stance as the infra rule above, kept separate
    // because the rangeStrategy below only applies to these managers).
    // rangeStrategy "update-lockfile" matters because pyproject.toml uses
    // unbounded >= ranges (ansible-core>=2.20, etc) on purpose — no need to
    // convert those to exact pins for Renovate to be useful. Without this,
    // an unbounded lower-bound range technically already "allows" any newer
    // version, so Renovate has nothing to widen and may not open PRs for it
    // at all. update-lockfile keeps the range in pyproject.toml exactly as
    // written and instead bumps the actual resolved version pinned in
    // uv.lock whenever a newer one satisfying that range is out — the file
    // that actually determines what gets installed.
    {
      matchManagers: ["pep621", "uv"],
      automerge: false,
      rangeStrategy: "update-lockfile",
    },

    // Direct-dependency minor/patch bumps only — lockFileMaintenance above
    // already groups the weekly transitive-pin refresh separately. Same
    // minor/patch-only, majors-stay-individual split as github-actions and
    // docker-compose/dockerfile groups.
    {
      matchManagers: ["pep621", "uv"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "python dependencies (minor/patch)",
      groupSlug: "python-deps-minor-patch",
    },

    // Every other docker-compose/Dockerfile image's minor and patch bumps,
    // lumped into one PR instead of ~15 separate ones. Majors stay
    // individual — more likely to need their own changelog read and their
    // own revert. Placed *before* the per-image groups below so their
    // matchDepNames rules (which match regardless of update type) still
    // win for seaweedfs, keeping that tied to its test fixture.
    {
      matchManagers: ["docker-compose", "dockerfile"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "docker images (minor/patch)",
      groupSlug: "docker-images-minor-patch",
    },

    // henrygd/beszel ships hub and agent from the same repo/release — the
    // agent even flags itself as version-mismatched in the hub UI if the
    // two drift apart (github.com/henrygd/beszel/discussions/654). Group so
    // they land, and get redeployed, together.
    {
      matchDepNames: ["ghcr.io/henrygd/beszel/beszel", "ghcr.io/henrygd/beszel/beszel-agent"],
      groupName: "beszel hub + agent (must move together)",
      groupSlug: "beszel",
    },

    // ghcr.io/tecnativa/docker-socket-proxy is the same security-sensitive
    // sidecar pinned identically and independently in three compose files
    // (beszel-agent, diun, lldap) — group so a version bump is reviewed and
    // rolled out once, not as three near-identical PRs.
    {
      matchDepNames: ["ghcr.io/tecnativa/docker-socket-proxy"],
      groupName: "docker-socket-proxy (all instances)",
      groupSlug: "docker-socket-proxy",
    },

    // ghcr.io/itzg/mc-backup is pinned identically in docker/minecraft/
    // compose.yaml (the running backup sidecar) and compose.restore.yaml
    // (the one-off restore job) — same image, same intended version, group
    // them.
    {
      matchDepNames: ["ghcr.io/itzg/mc-backup"],
      groupName: "mc-backup (compose + restore — must move together)",
      groupSlug: "mc-backup",
    },

    // openbao/openbao is pinned in the production compose file, openbao's
    // own ansible role defaults, deploy.yaml's step_ca_cert include_role
    // vars (resolves the image only to read its non-root UID for a
    // post-issuance/renewal chown, never to run the server itself; see
    // docs/topics/secrets/openbao.md), and — a different datasource, GitHub Releases
    // rather than the Docker Hub image, but grouped here via the shared
    // depName regardless (see that customManager's own comment) —
    // openbao_cli's native-CLI version pin on `security`. All four need
    // to stay in lockstep.
    {
      matchDepNames: ["openbao/openbao"],
      groupName: "openbao (compose, ansible role defaults, native CLI — must move together)",
      groupSlug: "openbao",
    },

    // openbao_cli_deb_sha256 is bumped by this PR from the digest GitHub lists
    // for the .deb on the new release. That is GitHub's hash of the asset, not
    // the publisher's signed one, so the note asks for the check Renovate
    // cannot make. Scoped to this datasource so it fires only on openbao_cli's
    // own bump, not on the group's image-only changes.
    {
      matchDatasources: ["custom.openbao-linux-amd64-deb"],
      matchDepNames: ["openbao/openbao"],
      prBodyNotes: [
        "ℹ️ openbao_cli_deb_sha256 (ansible/roles/openbao_cli/defaults/main.yaml) is updated by this PR from the digest GitHub lists for openbao_<version>_linux_amd64.deb. Check it against that release's checksums.txt before merging; the file's own checksum is the same place the asset came from.",
      ],
    },

    // The CodeRabbit manifest lists hashes with no version, so no datasource
    // can pair its hash with the version that VERSION returns: CODERABBIT_SHA256
    // is left stale and this PR's build check fails at the checksum until it is
    // replaced by hand. latest/SHA256SUMS is the manifest for the release
    // VERSION names.
    {
      matchDatasources: ["custom.coderabbit-cli"],
      matchDepNames: ["coderabbit-cli"],
      prBodyNotes: [
        "⚠️ CODERABBIT_SHA256 (tools/coderabbit-review/Dockerfile) is NOT updated by this PR — replace it with the `./coderabbit-linux-x64.zip` line of https://cli.coderabbit.ai/releases/<new version>/SHA256SUMS (the same file as releases/latest/SHA256SUMS while this is the latest release) before merging; until then this PR's build check fails at the checksum step. See docs/topics/engineering/coderabbit-review.md.",
      ],
    },

    // cd_agent_uv_sha256 is bumped by this PR from the release's own .sha256
    // asset, so the note asks for the one check Renovate cannot make: that
    // the hash is the file's published checksum and uv still reads uv.lock.
    {
      matchDatasources: ["github-release-attachments"],
      matchDepNames: ["astral-sh/uv"],
      prBodyNotes: [
        "ℹ️ cd_agent_uv_sha256 (ansible/roles/cd_agent/defaults/main.yaml) is updated by this PR from uv-x86_64-unknown-linux-gnu.tar.gz.sha256 on the new release. Check it against that release page, and that the new uv still reads the repository's uv.lock.",
      ],
    },

    // cd_agent_rclone_sha256 is bumped by this PR from the digest GitHub lists
    // for rclone-v<version>-linux-amd64.zip; the publisher's own hash is in the
    // clearsigned SHA256SUMS.
    {
      matchDatasources: ["custom.rclone-linux-amd64"],
      matchDepNames: ["rclone/rclone"],
      prBodyNotes: [
        "ℹ️ cd_agent_rclone_sha256 (ansible/roles/cd_agent/defaults/main.yaml) is updated by this PR from the digest GitHub lists for rclone-v<version>-linux-amd64.zip. Check it against the line in the release's SHA256SUMS (signed with the key at https://rclone.org/release_signing/) before merging.",
      ],
    },

    // rclone/rclone is pinned independently in cloud_sync's ExecStart=
    // and backup_agent's freshness-check script (both need the custom
    // regex managers above, neither is a real compose/dockerfile image:
    // line) — aligned to the same version (1.72) as of this rule being
    // added; group them so they can't drift apart again the way they
    // already had before this was noticed. cd_agent's native rclone joins
    // them: leaf-key verification has to follow the request sequence
    // cloud_sync's rclone makes.
    {
      matchDepNames: ["rclone/rclone"],
      groupName: "rclone (cloud_sync + backup_agent + cd_agent — must move together)",
      groupSlug: "rclone",
    },

    // Same image pinned in prod tasks, Molecule fixtures and the Molecule
    // playbooks' vars/images/ files, which different managers read — without a
    // group each manager opens its own PR and the copies drift between
    // merges.
    {
      matchDepNames: ["alpine"],
      groupName: "alpine (prod roles, Molecule fixtures and playbooks — must move together)",
      groupSlug: "alpine",
    },
    {
      matchDepNames: ["curlimages/curl"],
      groupName: "curl image (lldap_bootstrap + its Molecule verify — must move together)",
      groupSlug: "curl-image",
    },
    {
      matchDepNames: ["ghcr.io/lldap/lldap"],
      groupName: "lldap (compose, Molecule targets — must move together)",
      groupSlug: "lldap",
    },

    // smallstep/step-ca and smallstep/step-cli are pinned independently
    // in four places with no shared source of truth: step_ca_cert's own
    // step-cli default, the CI script that seeds step-ca for the
    // compose-boot-test workflow, molecule_helpers' step-ca test target,
    // and the Molecule playbooks' vars/images/ files. All but the test
    // target (a real image: key) need the custom regex managers above —
    // group them so a version bump can't land in one place and leave the
    // others stale.
    {
      matchDepNames: ["smallstep/step-ca", "smallstep/step-cli"],
      groupName: "smallstep step-ca + step-cli (prod, CI fixture, molecule target — must move together)",
      groupSlug: "smallstep",
    },

    // Every other ansible-galaxy collection bump, lumped into one PR —
    // same minor/patch-only, majors-stay-individual split as the other
    // groups here. Placed *before* the community.docker/ansible.posix
    // override below so that rule's groupName still wins for those two
    // (same ordering reasoning as "docker images (minor/patch)" above).
    {
      matchManagers: ["ansible-galaxy"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "ansible galaxy collections (minor/patch)",
      groupSlug: "ansible-galaxy-minor-patch",
    },

    // community.docker/ansible.posix/amazon.aws/community.hashi_vault are
    // pinned identically in ansible/requirements.yml (real playbook runs) and
    // ansible/roles/molecule_helpers/requirements.yml (what molecule tests
    // against) — same reasoning as the docker-image pairs above: group them
    // so the test fixture can't silently drift from what's actually run.
    {
      matchManagers: ["ansible-galaxy"],
      matchDepNames: ["community.docker", "ansible.posix", "amazon.aws", "community.hashi_vault"],
      groupName: "ansible galaxy collections (playbook + molecule — must move together)",
      groupSlug: "ansible-galaxy-core",
    },

    // docker/lldap/compose.yaml, docker/bind9/compose.yaml, and
    // docker/caddy/compose.yaml's molecule fixtures are symlinks to
    // these same files (see docs/topics/engineering/molecule-testing.md), so there is only
    // ever one real occurrence of each of those image pins for Renovate
    // to see — no groupName needed to keep prod and test fixture in
    // lockstep, because there's nothing left to drift apart.

    // docker/seaweedfs/compose.yaml (production) and
    // molecule_helpers/tasks/start_seaweedfs_test_target.yaml (the real
    // SeaweedFS instance the seaweedfs_bucket role's molecule scenarios
    // test against) are two independent, hard-coded pins of the same
    // image with no shared source of truth — Renovate needs literal
    // image: strings in both, so there's no clean way to template one
    // from the other. Group them into a single PR so they can only ever
    // be bumped together, never independently.
    //
    // depName is ghcr.io/chrislusf/seaweedfs (not chrislusf/seaweedfs) as
    // of the GHCR port — the project's GitHub org moved from chrislusf to
    // seaweedfs a while back, but the image path on both Docker Hub and
    // GHCR is still under the old chrislusf/ name.
    {
      matchDepNames: ["ghcr.io/chrislusf/seaweedfs"],
      groupName: "seaweedfs (prod + molecule test target — must move together)",
      groupSlug: "seaweedfs",
    },

    // seaweedfs is critical storage backend
    {
      matchDepNames: ["ghcr.io/chrislusf/seaweedfs"],
      matchUpdateTypes: ["major"],
      labels: ["needs-manual-review"],
      prBodyNotes: [
        "⚠️ Major version bump on the storage backend, grouped with its molecule test-target fixture so both move together. Review the SeaweedFS changelog and test against a snapshot before merging.",
      ],
    },

    // The following stay on Docker Hub (no GHCR mirror exists, or — for
    // dockge — GHCR only publishes `nightly` builds, not the stable
    // versioned releases we actually run) and ship no
    // org.opencontainers.image.source label of their own. Verified via
    // `skopeo inspect docker://docker.io/<image>:latest` — Labels came
    // back empty/absent for all of these, so Renovate has nothing to
    // derive a changelog link from unless we supply it.
    {
      matchDatasources: ["docker"],
      matchDepNames: ["ubuntu/bind9"],
      sourceUrl: "https://github.com/canonical/bind9-rock",
    },
    {
      matchDatasources: ["docker"],
      matchDepNames: ["quxfoo/wastebin"],
      sourceUrl: "https://github.com/matze/wastebin",
    },
    {
      matchDatasources: ["docker"],
      matchDepNames: ["certbot/dns-digitalocean"],
      sourceUrl: "https://github.com/certbot/certbot",
    },
    {
      matchDatasources: ["docker"],
      matchDepNames: ["amazon/aws-cli"],
      sourceUrl: "https://github.com/aws/aws-cli",
    },
    {
      matchDatasources: ["docker"],
      matchDepNames: ["louislam/dockge"],
      sourceUrl: "https://github.com/louislam/dockge",
    },

    // caddy DOES carry a source label, but it points at
    // caddyserver/caddy-docker — the repo that generates the Dockerfile,
    // which has no tagged releases or changelog of its own — rather than
    // caddyserver/caddy, where the actual version bumps and release
    // notes live. Renovate's own sourceUrl override is confirmed to
    // reliably fill in a *missing* value but is not guaranteed to
    // override a value the datasource already resolved (see
    // renovatebot/renovate#41505): check the next Dockerfile-bump PR to
    // confirm the link actually changed to caddyserver/caddy; if it
    // doesn't take, fall back to `changelogUrl` instead.
    {
      matchDatasources: ["docker"],
      matchDepNames: ["caddy"],
      sourceUrl: "https://github.com/caddyserver/caddy",
    },
  ],
}
