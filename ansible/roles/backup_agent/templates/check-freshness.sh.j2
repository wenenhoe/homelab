#!/bin/sh
# Checks whether every app's newest backup object in SeaweedFS is
# within that app's own freshness threshold - derived from that app's
# own cron (see build_schedules.yaml), not a single shared value - and
# pushes ONCE to this host's single Gatus endpoint
# only if every app currently checked is fresh — see docs/topics/monitoring/gatus.md for why this
# exists instead of docker-volume-backup's own exec-hook labels (would
# need Docker `exec` access this host's socket-proxy deliberately
# doesn't grant), and why it's one push per HOST rather than one per
# app: every app's credential is already scoped to this host's own
# {host}-* prefix, so a future app added to this host needs no new
# config here at all.
#
# One stale app suppresses the whole host's push - Gatus shows "this
# host's backups" as one endpoint, not one per app. Which specific app
# is stale is only visible in this unit's own journal, not from Gatus.
#
# check_app's three possible outcomes matter, not just pass/fail:
#   0 = fresh                                      -> counts toward the push
#   1 = ran fine, nothing fresh yet (not an error)  -> suppresses the push, no alert
#   2 = rclone/docker itself failed to run          -> suppresses the push, DOES alert
# Collapsing 1 and 2 into the same "failure" would make this alert on
# ordinary staleness constantly, defeating the point of leaving that to
# Gatus's own missed-heartbeat alert instead.
set -eu

check_app() {
  app_name="$1"
  s3_path="$2"
  max_age="$3"

  # stdout and stderr captured separately, not merged with 2>&1: rclone
  # always emits at least one NOTICE line to stderr (its own "no config
  # file, using defaults" message) regardless of whether any file
  # matched --max-age, so a merged capture is never actually empty even
  # when the real file listing correctly found nothing - confirmed live
  # against a real rclone run, not assumed.
  rclone_stderr=$(mktemp)
  set +e
  # --network: harmless in production (a bridge network still has
  # normal outbound internet access to the real public HTTPS endpoint)
  # but required for Molecule's own test target, a container-name-only
  # endpoint only resolvable via Docker's embedded DNS on the network
  # it's actually attached to. backup_agent_network_name is discovered
  # in tasks/main.yaml, not hardcoded - the network's actual runtime
  # name isn't simply "backup-agent-net" (see that task's own comment).
  # Credentials go in an env file, not docker run's own arguments — those
  # are visible to any local user via ps/proc, unlike an env file rclone
  # itself reads. rclone honors RCLONE_S3_* for the on-the-fly ":s3:" remote
  # the same as the equivalent --s3-* flags (confirmed live, not assumed).
  s3_env_file=$(mktemp)
  chmod 600 "${s3_env_file}"
  cat > "${s3_env_file}" <<S3ENV
RCLONE_S3_ENDPOINT={{ seaweedfs_s3_proto }}://{{ seaweedfs_s3_endpoint }}
RCLONE_S3_ACCESS_KEY_ID={{ seaweedfs_s3_access_key }}
RCLONE_S3_SECRET_ACCESS_KEY={{ seaweedfs_s3_secret_key }}
RCLONE_S3_PROVIDER=Other
RCLONE_S3_REGION=global
RCLONE_S3_FORCE_PATH_STYLE=true
S3ENV

  # The container only lists: it mounts nothing and reads its credentials
  # from the env file docker itself passes in, so it needs no capability,
  # no write access and no root.
  output=$(docker run --rm --network {{ backup_agent_network_name }} --env-file "${s3_env_file}" \
    --cap-drop ALL --security-opt no-new-privileges:true --read-only --user 65534:65534 \
    rclone/rclone:1.75@sha256:2687085f718d3c628f7fdfb77c52a1d344332aed543110bb88088f2c70d43eb5 lsf \
    ":s3:{{ seaweedfs_s3_bucket }}/${s3_path}/" \
    --max-age "${max_age}" \
    --files-only 2>"${rclone_stderr}")
  rc=$?
  set -e
  stderr_content=$(cat "${rclone_stderr}")
  rm -f "${rclone_stderr}" "${s3_env_file}"

  if [ "${rc}" -ne 0 ]; then
    echo "${app_name}: rclone failed (exit ${rc}): ${stderr_content}" >&2
    return 2
  fi

  if [ -n "${output}" ]; then
    echo "${app_name}: backup newer than ${max_age} found"
    return 0
  else
    echo "${app_name}: no backup newer than ${max_age} found (not an error)"
    return 1
  fi
}

overall_fresh=true
had_infra_error=false

{% for app in backup_agent_schedules %}
if check_app "{{ app.app }}" "{{ inventory_hostname }}-{{ app.app }}" "{{ app.freshness_hours }}h"; then
  app_rc=0
else
  app_rc=$?
fi
if [ "${app_rc}" -eq 2 ]; then
  had_infra_error=true
  overall_fresh=false
elif [ "${app_rc}" -eq 1 ]; then
  overall_fresh=false
fi
{% endfor %}

push_failed=false

if [ "${overall_fresh}" = "true" ]; then
  echo "every app on this host is fresh, pushing"
  # A failed push fails the unit, so OnFailure= alerts.
  # The token goes to curl on stdin, not as an argument: those are visible to
  # any local user via ps/proc.
  curl -fsS --max-time 10 -K - >/dev/null <<'GATUS_PUSH' || push_failed=true
url = "{{ heartbeat_push_urls['backup-' ~ inventory_hostname] }}"
request = "POST"
header = "Authorization: Bearer {{ heartbeat_job_tokens['backup-' ~ inventory_hostname] }}"
GATUS_PUSH
else
  echo "at least one app is not fresh (see above) - not pushing, relying on Gatus's own missed-heartbeat alert"
fi

if [ "${had_infra_error}" = "true" ] || [ "${push_failed}" = "true" ]; then
  exit 1
fi
exit 0
