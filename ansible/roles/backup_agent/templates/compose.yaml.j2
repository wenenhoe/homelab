name: backup-agent

services:
{% if backup_agent_any_stop_apps %}
  backup-dockerproxy:
    image: ghcr.io/tecnativa/docker-socket-proxy:v0.5.0@sha256:1f5038b54f06c3e18422902cf00ba21803d1c97805aae032e5e6673d532d3459
    container_name: backup-agent-dockerproxy
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./docker-api-rules.cfg:/usr/local/etc/haproxy/haproxy.cfg.template:ro
    networks:
      - backup-agent-net
    restart: unless-stopped
    healthcheck:
      test: [ "CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:2375/version" ]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    # Compose recreates a container when its own config changes, not when a
    # bind-mounted file does, and HAProxy reads the rules only at start.
    labels:
      docker-api-rules-sha256: "{{ lookup('ansible.builtin.file', 'docker-api-rules.cfg', rstrip=false) | hash('sha256') }}"
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
{% endif %}

  backup-agent:
    image: ghcr.io/offen/docker-volume-backup:v2.49.3@sha256:570a4bea8c19f824b22a4ce31e01afdf418a7bb616dcb17052f0a78b504ac54c
    container_name: backup-agent
    volumes:
{% for app in backup_plan %}
{% for vol in app.volumes %}
      - {{ app.name }}_{{ vol }}:/backup/{{ app.name }}/{{ app.name }}_{{ vol }}:ro
{% endfor %}
{% endfor %}
      - ./gpg-public-key.asc:/etc/backup/gpg-public-key.asc:ro
      - ./conf.d:/etc/dockervolumebackup/conf.d:ro
      - ./notification-failure.template:/etc/dockervolumebackup/notifications.d/01-failure.template:ro
    env_file:
      - .env
    networks:
      - backup-agent-net
    restart: unless-stopped
    # -foreground's own scheduler is the entrypoint process itself (PID
    # 1, named "backup") — no separate daemon and no HTTP endpoint to
    # probe, so this only confirms that process is still alive.
    healthcheck:
      test: [ "CMD", "pgrep", "backup" ]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    # Runs as root over files other users own: the 0600 schedule files in
    # conf.d belong to the deploy user and each backed-up volume keeps its
    # app's UID. After cap_drop ALL, DAC_READ_SEARCH is the one capability
    # that lets it open them (every mount is read-only); without it the
    # container stays up and healthy but cannot read what it archives.
    cap_add:
      - DAC_READ_SEARCH
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true

networks:
  backup-agent-net:
    driver: bridge

volumes:
{% for app in backup_plan %}
{% for vol in app.volumes %}
  {{ app.name }}_{{ vol }}:
    external: true
    name: {{ app.name }}_{{ vol }}
{% endfor %}
{% endfor %}
