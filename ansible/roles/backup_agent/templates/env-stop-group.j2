TZ={{ server_timezone }}

AWS_S3_BUCKET_NAME={{ offsite_backup_s3_bucket }}
AWS_S3_PATH={{ inventory_hostname }}-stop-group
AWS_ENDPOINT={{ offsite_backup_s3_endpoint }}
AWS_ACCESS_KEY_ID={{ seaweedfs_s3_access_key }}
AWS_SECRET_ACCESS_KEY={{ seaweedfs_s3_secret_key }}
AWS_S3_FORCE_PATH_STYLE=true

BACKUP_CRON_EXPRESSION="{{ backup_agent_stop_group_cron }}"
BACKUP_FILENAME={{ inventory_hostname }}-stop-group-%Y-%m-%dT%H-%M-%S.tar.gz
BACKUP_RETENTION_DAYS={{ backup_agent_stop_group_retention }}
BACKUP_PRUNING_LEEWAY=5m

# Apps in this group: {{ backup_agent_stop_group | map(attribute='name') | join(', ') }}
# Each carries its own docker-volume-backup.stop-during-backup=true label —
# this instance stops ALL of them for the duration of the whole archive run,
# not just while its own subdirectory is being read (docker-volume-backup
# has no per-subdirectory granularity). See docs/disaster-recovery.md.
BACKUP_STOP_DURING_BACKUP_LABEL=docker-volume-backup.stop-during-backup=true
DOCKER_HOST=tcp://backup-agent-dockerproxy:2375

GPG_PUBLIC_KEY_FILE=/etc/backup/gpg-public-key.asc
