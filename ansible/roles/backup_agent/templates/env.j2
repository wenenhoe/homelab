TZ={{ server_timezone }}
GPG_PUBLIC_KEY_RING_FILE=/etc/backup/gpg-public-key.asc

# Per-app settings (AWS_*, cron, retention, BACKUP_SOURCES,
# BACKUP_STOP_DURING_BACKUP_LABEL) live in conf.d/*.env instead — one
# file per app, see schedule.env.j2 and tasks/main.yaml. Only settings
# shared by every schedule on this host stay here.

# Apps backed up on this host: {{ backup_agent_normalized | map(attribute='name') | join(', ') }}
{% if backup_agent_any_stop_apps %}
DOCKER_HOST=tcp://backup-agent-dockerproxy:2375
{% endif %}

# NOTIFICATION_LEVEL isn't set — offen/docker-volume-backup already
# defaults to "error", so this only fires on a failed run, not every
# successful one. See docs/telegram-notifications.md.
NOTIFICATION_URLS=telegram://{{ telegram_token }}@telegram?chats={{ telegram_chatid_backups }}
