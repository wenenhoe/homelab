{# item.app, item.sources, item.retention, item.cron, item.stop_label
   come in via the loop that renders this — tasks/main.yaml. Always
   SeaweedFS: cloud coverage lives entirely in the cloud_sync role on
   storage now, never here. #}
AWS_S3_BUCKET_NAME={{ offsite_backup_s3_bucket }}
AWS_S3_PATH={{ inventory_hostname }}-{{ item.app }}
AWS_ENDPOINT={{ offsite_backup_s3_endpoint }}
AWS_ENDPOINT_PROTO={{ offsite_backup_s3_proto }}
AWS_ACCESS_KEY_ID={{ seaweedfs_s3_access_key }}
AWS_SECRET_ACCESS_KEY={{ seaweedfs_s3_secret_key }}
AWS_S3_FORCE_PATH_STYLE=true

BACKUP_SOURCES={{ item.sources | join(' ') }}
BACKUP_CRON_EXPRESSION="{{ item.cron }}"
BACKUP_FILENAME={{ inventory_hostname }}-{{ item.app }}-%Y-%m-%dT%H-%M-%S.tar.gz
BACKUP_RETENTION_DAYS={{ item.retention }}
BACKUP_PRUNING_LEEWAY=5m
{% if item.stop_label %}
BACKUP_STOP_DURING_BACKUP_LABEL={{ item.stop_label }}
{% endif %}
