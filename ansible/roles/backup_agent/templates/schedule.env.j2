{# item.app, item.sources, item.target, item.retention, item.cron,
   item.stop_label come in via the loop that renders this — tasks/main.yaml. #}
AWS_S3_BUCKET_NAME={{ cloud_backup_targets[item.target].bucket }}
{# seaweedfs keeps its pre-multi-cloud, pre-per-app path shape (just
   hostname-app, no target suffix) purely by convention with the other
   targets below — this is a fresh path either way, see the migration
   note in docs/disaster-recovery.md for why. #}
AWS_S3_PATH={{ inventory_hostname }}-{{ item.app }}{{ '' if item.target == 'seaweedfs' else '-' ~ item.target }}
AWS_ENDPOINT={{ cloud_backup_targets[item.target].endpoint }}
AWS_ENDPOINT_PROTO={{ cloud_backup_targets[item.target].proto }}
AWS_ACCESS_KEY_ID={{ cloud_backup_targets[item.target].access_key }}
AWS_SECRET_ACCESS_KEY={{ cloud_backup_targets[item.target].secret_key }}
AWS_S3_FORCE_PATH_STYLE=true

BACKUP_SOURCES={{ item.sources | join(' ') }}
BACKUP_CRON_EXPRESSION="{{ item.cron }}"
BACKUP_FILENAME={{ inventory_hostname }}-{{ item.app }}-{{ item.target }}-%Y-%m-%dT%H-%M-%S.tar.gz
BACKUP_RETENTION_DAYS={{ item.retention }}
BACKUP_PRUNING_LEEWAY=5m
{% if item.stop_label %}
BACKUP_STOP_DURING_BACKUP_LABEL={{ item.stop_label }}
{% endif %}
