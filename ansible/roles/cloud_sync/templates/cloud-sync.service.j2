[Unit]
Description=Copy SeaweedFS backup archives onward to R2/B2/OCI
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=0
# Fires whenever run.sh's own overall_status reflects at least one
# failed job (see run.sh.j2) — that's what ExecStart's own exit code
# carries through to systemd here, there's no separate skip condition
# to distinguish from a real failure the way cert-renewer@ has.
OnFailure=telegram-notify-cloud-sync.service
# Liveness signal only - see docs/topics/monitoring/uptime-kuma.md for why this never
# pushes an explicit down status on failure instead.
OnSuccess=uptime-kuma-push-cloud-sync.service gatus-push-cloud-sync.service

[Service]
Type=oneshot
User=root

# --entrypoint sh, not the image's own rclone entrypoint — run.sh is the
# actual command here, rclone itself is invoked repeatedly from inside
# it, once per job in jobs.txt.
#
# DAC_OVERRIDE is the one capability kept: rclone.conf is 0600 and owned by
# the deploy user, which root can't open without it (rclone then stops with
# "Failed to load config file ... permission denied" and every job fails).
# Every mount is read-only and rclone writes nothing locally, so the root
# filesystem is read-only too; the network stays, that is the job.
ExecStart=/usr/bin/docker run --rm \
  --cap-drop ALL \
  --cap-add DAC_OVERRIDE \
  --security-opt no-new-privileges:true \
  --read-only \
  -v {{ compose_deploy_dir }}/cloud-sync/rclone.conf:/config/rclone/rclone.conf:ro \
  -v {{ compose_deploy_dir }}/cloud-sync/jobs.txt:/jobs.txt:ro \
  -v {{ compose_deploy_dir }}/cloud-sync/run.sh:/run.sh:ro \
  --entrypoint sh \
  rclone/rclone:1.75@sha256:2687085f718d3c628f7fdfb77c52a1d344332aed543110bb88088f2c70d43eb5 \
  /run.sh

[Install]
WantedBy=multi-user.target
