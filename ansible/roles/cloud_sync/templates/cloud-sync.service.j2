[Unit]
Description=Copy SeaweedFS backup archives onward to R2/B2/OCI
After=network-online.target docker.service
Requires=docker.service
StartLimitIntervalSec=0
# Fires whenever run.sh's own overall_status reflects at least one
# failed job (see run.sh.j2) — that's what ExecStart's own exit code
# carries through to systemd here, there's no separate skip condition
# to distinguish from a real failure the way cert-renewer@ has.
OnFailure=telegram-notify-cloud-sync.service
# Liveness signal only - see docs/uptime-kuma.md for why this never
# pushes an explicit down status on failure instead.
OnSuccess=uptime-kuma-push-cloud-sync.service

[Service]
Type=oneshot
User=root

# --entrypoint sh, not the image's own rclone entrypoint — run.sh is the
# actual command here, rclone itself is invoked repeatedly from inside
# it, once per job in jobs.txt.
ExecStart=/usr/bin/docker run --rm \
  -v {{ compose_deploy_dir }}/cloud-sync/rclone.conf:/config/rclone/rclone.conf:ro \
  -v {{ compose_deploy_dir }}/cloud-sync/jobs.txt:/jobs.txt:ro \
  -v {{ compose_deploy_dir }}/cloud-sync/run.sh:/run.sh:ro \
  --entrypoint sh \
  rclone/rclone:1.75 \
  /run.sh

[Install]
WantedBy=multi-user.target
