[Unit]
Description=Telegram alert for a failed certificate renewal (%i)
Documentation=https://core.telegram.org/bots/api#sendmessage

[Service]
Type=oneshot
EnvironmentFile=/etc/telegram-notify/env

; %i is the *invoking* unit's own instance (e.g. cert-renewer@lldap.service
; sets OnFailure=telegram-notify@%i.service, so %i="lldap" here too) - not
; a generic failed-unit name. Message wording below assumes that shape;
; this template is coupled to cert-renewer@, not a catch-all notifier.
; message_thread_id is only added when a topic ID is actually configured -
; Telegram's API rejects the param outright if passed empty rather than
; ignoring it (see docs/telegram-notifications.md).
ExecStart=/usr/bin/curl -fsS --max-time 10 --data-urlencode "chat_id=${TELEGRAM_CHAT_ID}" --data-urlencode "text=Certificate renewal failed for %i on {{ ansible_hostname }}" {{ ('--data-urlencode "message_thread_id=' ~ telegram_topic_id_certs ~ '"') if telegram_topic_id_certs else '' }} https://api.telegram.org/bot${TELEGRAM_TOKEN}/sendMessage
