# Rendered by restore_discovery — do not edit by hand, re-run
# playbooks/restore-discovery-setup.yaml (or restore_all.py, which runs
# it for you) to refresh. Read-only credentials only, unlike
# cloud_sync's own rclone.conf on `storage` — see
# docs/cloud-credential-creation.md. Same shape, including the
# endpoint-scheme convention, as
# ansible/roles/cloud_sync/templates/rclone.conf.j2 — see that
# template's own header instead of repeating it here.
#
# NEEDS LIVE VERIFICATION per remote before trusting a real restore —
# confirm with `rclone lsd --config rclone.conf <name>:` (see
# docs/restore.md's batch-restore section).

[seaweedfs]
type = s3
provider = Other
access_key_id = {{ secrets_generated['seaweedfs-s3-access-key-cloud-sync-reader'] }}
secret_access_key = {{ secrets_generated['seaweedfs-s3-secret-key-cloud-sync-reader'] }}
endpoint = {{ offsite_backup_s3_proto }}://{{ offsite_backup_s3_endpoint }}
force_path_style = true
{% for target, config in hostvars['storage'].cloud_sync_targets.items() %}

[{{ target }}]
type = s3
provider = Other
access_key_id = {{ restore_discovery_cloud_read_credentials[target].access_key }}
secret_access_key = {{ restore_discovery_cloud_read_credentials[target].secret_key }}
endpoint = {{ config.endpoint }}
force_path_style = true
{% endfor %}
