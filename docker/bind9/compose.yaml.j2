name: bind9

services:
  bind9:
    image: ubuntu/bind9:9.20-26.04_stable@sha256:40de980b768d75ccbf43fe9d95836039597d3ae745aadbf2bffdab35f45540dd
    container_name: bind9
    volumes:
      - config:/etc/bind
      - cache:/var/cache/bind
      # nocopy: the first start of an empty volume would otherwise give it the
      # image directory's owner, undoing the role's chown to bind for a secondary.
      - type: volume
        source: records
        target: /var/lib/bind
        volume:
          nocopy: true
      - run:/run/named
    environment:
      - TZ={{ server_timezone }}
    ports:
      - '0.0.0.0:53:53/tcp'
      - '0.0.0.0:53:53/udp'
    command: [ "--args", "dns-server", "-g", "-u", "bind", "-4" ]
    restart: unless-stopped
    healthcheck:
      test: [ "CMD", "pebble", "health" ]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    user: bind:bind
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
volumes:
  config:
    external: true
    name: bind9_config
  cache:
    external: true
    name: bind9_cache
  records:
    external: true
    name: bind9_records
  run:
    external: true
    name: bind9_run
