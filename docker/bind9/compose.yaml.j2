name: bind9

services:
  bind9:
    image: ubuntu/bind9:9.20-26.04_stable@sha256:84bbcf553e8da7d418b986f573bd88ae6a74a0692a2ce04c19e2af33218702ed
    container_name: bind9
    volumes:
      - config:/etc/bind
      - cache:/var/cache/bind
      # nocopy: the first start of an empty volume would otherwise give it the
      # image directory's owner, undoing the role's chown to bind for a secondary.
      - type: volume
        source: records
        target: /var/lib/bind
        volume:
          nocopy: true
      - run:/run/named
    environment:
      - TZ={{ server_timezone }}
    ports:
      - '0.0.0.0:53:53/tcp'
      - '0.0.0.0:53:53/udp'
    command: [ "--args", "dns-server", "-g", "-u", "bind", "-4" ]
    restart: unless-stopped
    healthcheck:
      test: [ "CMD", "pebble", "health" ]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    user: bind:bind
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
volumes:
  config:
    external: true
    name: bind9_config
  cache:
    external: true
    name: bind9_cache
  records:
    external: true
    name: bind9_records
  run:
    external: true
    name: bind9_run
