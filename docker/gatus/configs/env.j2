TELEGRAM_TOKEN={{ telegram_token }}
TELEGRAM_CHAT_ID={{ telegram_chat_id }}
{% for group in heartbeat_jobs | map(attribute='group') | unique | sort %}
TELEGRAM_TOPIC_ID_{{ group | upper }}={{ lookup('vars', 'telegram_topic_id_' ~ group) }}
{% endfor %}
DASHBOARD_PASSWORD_BCRYPT_BASE64={{ gatus_dashboard_password_bcrypt_base64 }}
{% for job in heartbeat_jobs %}
HEARTBEAT_TOKEN_{{ job.id | upper | replace('-', '_') }}={{ heartbeat_job_tokens[job.id] }}
{% endfor %}
