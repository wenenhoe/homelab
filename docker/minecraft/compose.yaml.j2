name: minecraft

services:
  backups:
    image: ghcr.io/itzg/mc-backup:2026.10.1@sha256:c5f2c369bbe47d0b712601bf44af5927e67a18cb5816dc378efb45eb993dab0a
    container_name: minecraft-backups
    depends_on:
      mc:
        condition: service_healthy
    volumes:
      - data:/data:ro
      - backups:/backups
    environment:
      TZ: "{{ server_timezone }}"
      CRON_SCHEDULE: "0 4 * * *" # backup everyday at 4am
      CRON_BACKUP_UID: "1000"
      RCON_HOST: mc
      # Local retention is count-based only: keep the single most recent
      # on-host snapshot. Day-based pruning (PRUNE_BACKUPS_DAYS defaults to
      # 7 upstream) is explicitly disabled rather than left implicit, so
      # there's one unambiguous prune rule instead of two overlapping ones.
      PRUNE_BACKUPS_COUNT: "1"
      PRUNE_BACKUPS_DAYS: "0"
    restart: always
    # No listening port to probe, so this checks that the cron scheduler
    # (crond, the container's foreground process here) is alive — it does
    # NOT confirm the most recent backup actually succeeded.
    healthcheck:
      test: [ "CMD", "pgrep", "crond" ]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    cap_add:
      - CHOWN
      - SETGID
      - SETUID
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
  bluemap:
    image: ghcr.io/bluemap-minecraft/bluemap:v5@sha256:bb49bfdef996c6fd9cf68c8c6a2b79189e6711fa90ae4d43cf22d81a6811301e
    container_name: minecraft-bluemap
    depends_on:
      mc:
        condition: service_healthy
    volumes:
      - bluemap_config:/app/config
      - bluemap_web:/app/web
      - bluemap_data:/app/data
      - type: volume
        source: data
        target: /app/world
        volume:
          subpath: world
    networks:
      - caddy-proxy
    command: -r -u -w
    restart: always
    # Image has bash but no curl/wget, so this uses bash's built-in
    # /dev/tcp to confirm the webserver (-w) is accepting connections.
    healthcheck:
      test: [ "CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8100" ]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    cap_add:
      - DAC_OVERRIDE
    cap_drop:
      - ALL
    expose:
      - '8100'
    security_opt:
      - no-new-privileges:true
  mc:
    image: ghcr.io/itzg/minecraft-server:java25@sha256:ed3fac82a0d05b37adc1c623509a0aafebd34182e3ed86562e28434a7bc4276a
    container_name: minecraft-mc
    volumes:
      - data:/data
      - extras:/extras:ro
    environment:
      TZ: "{{ server_timezone }}"
      EULA: "TRUE"
      INIT_MEMORY: 1G
      MAX_MEMORY: 2G
      TYPE: FABRIC
      VERSION: 1.21.11
      MOTD: |
        §l§6🎣 My Forever World 🏹§r
        A %TYPE% server on %VERSION%
      MODRINTH_LOADER: fabric
      MODRINTH_DOWNLOAD_DEPENDENCIES: required
      MODRINTH_PROJECTS_DEFAULT_VERSION_TYPE: beta # "release"
      MODRINTH_MODPACK: simply-optimized-up-to-date
      MODRINTH_PROJECTS: "@/extras/modrinth-mods.txt"
    ports:
      - '0.0.0.0:25565:25565'
    restart: unless-stopped
    cap_add:
      - CHOWN
      - SETGID
      - SETUID
    cap_drop:
      - ALL
    expose:
      - '25575' # RCON port
    security_opt:
      - no-new-privileges:true
    stdin_open: true
    tty: true
networks:
  caddy-proxy:
    external: true
volumes:
  data:
    external: true
    name: minecraft_data
  backups:
    external: true
    name: minecraft_backups
  bluemap_config:
    external: true
    name: minecraft_bluemap_config
  bluemap_web:
    external: true
    name: minecraft_bluemap_web
  bluemap_data:
    external: true
    name: minecraft_bluemap_data
  extras:
    external: true
    name: minecraft_extras
