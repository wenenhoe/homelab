# Single-node raft storage; multi-node is not planned.
storage "raft" {
  path    = "/openbao/data"
  node_id = "openbao-security"
}

listener "tcp" {
  address          = "0.0.0.0:8200"
  cluster_address  = "0.0.0.0:8201"
  tls_cert_file    = "/openbao/certs/fullchain.pem"
  tls_key_file     = "/openbao/certs/privkey.pem"
}

# Both must resolve for a client actually connecting - "openbao" is this
# compose service's own name on caddy-proxy, the same first-name-must-
# self-resolve convention step-ca's STEP_CA_DNS_NAMES already uses (see
# docs/topics/services/step-ca.md). cluster_addr is unused on a single-node cluster
# (nothing ever joins) but still required config.
api_addr     = "https://openbao:8200"
cluster_addr = "https://openbao:8201"

# No UI - see docs/topics/secrets/openbao.md for why this stays CLI/API-only.
ui = false

# Declarative, not API-driven (unsafe_allow_api_audit_creation would be
# needed for that route - see ADR 0026 for why that's rejected). Writes
# to stdout, captured by Docker's own log driver - compose.yaml.j2's
# logging: block is what bounds its growth, not this file.
#
# description is compared against the stored device on every unseal and
# SIGHUP; any difference fails post-unseal setup and the node never goes
# active. Keep this string byte-identical to what was first registered,
# even though its doc path is stale - a docs path sweep must skip it.
audit "file" "openbao" {
  description = "Request/response audit log - see docs/openbao.md's Audit logging section and ADR 0026"
  options {
    file_path = "stdout"
  }
}
