[Unit]
Description=Check rotation-read-watcher.service is active, push heartbeat on success
; Same convention as cloud_sync/cert-renewer@/cert-expiry-check
; (docs/topics/monitoring/gatus.md): OnSuccess= only, never an explicit failure
; push - Gatus's own missed-heartbeat alert is the backstop for
; a watcher that's stopped or crash-looping.
OnSuccess=gatus-push-rotation-read-watcher.service

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl is-active --quiet rotation-read-watcher.service
