name: seaweedfs

services:
  seaweedfs:
    image: ghcr.io/chrislusf/seaweedfs:4.44
    container_name: seaweedfs
    volumes:
      - data:/data
      - type: volume
        source: data
        target: /etc/seaweedfs/s3-identity.json
        volume:
          subpath: s3-identity.json
    environment:
      TZ: "{{ server_timezone }}"
    networks:
      - caddy-proxy
    # All-in-one mode (master+volume+filer+S3 in one process) — no HA,
    # acceptable for stage-1 DR which only needs an off-host copy.
    command: >
      server -dir=/data -master.volumeSizeLimitMB=1024 -volume.max=0 -filer -s3 -s3.port=8333 -s3.config=/etc/seaweedfs/s3-identity.json
    restart: unless-stopped
    healthcheck:
      test: [ "CMD", "wget", "-q", "--spider", "http://seaweedfs:8888/" ]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    expose:
      - '8333' # S3 API
      - '8888' # Filer web UI, fronted by Tinyauth via Caddy
networks:
  caddy-proxy:
    external: true
volumes:
  data:
    external: true
    name: seaweedfs_data
