{
  "identities": [
    {
      "name": "seaweedfs-bucket-admin",
      "credentials": [
        {
          "accessKey": "{{ seaweedfs_admin_access_key }}",
          "secretKey": "{{ seaweedfs_admin_secret_key }}"
        }
      ],
      "actions": [
        "Admin:{{ offsite_backup_s3_bucket }}"
      ]
    },
    {
      "name": "seaweedfs-cloud-sync-reader",
      "credentials": [
        {
          "accessKey": "{{ seaweedfs_cloud_sync_reader_access_key }}",
          "secretKey": "{{ seaweedfs_cloud_sync_reader_secret_key }}"
        }
      ],
      "actions": [
        "Read:{{ offsite_backup_s3_bucket }}",
        "List:{{ offsite_backup_s3_bucket }}"
      ]
    }{{ "," if seaweedfs_backup_hosts else "" }}
{% for host in seaweedfs_backup_hosts %}
    {
      "name": "seaweedfs-backup-{{ host }}",
      "credentials": [
        {
          "accessKey": "{{ hostvars[host].seaweedfs_s3_access_key }}",
          "secretKey": "{{ hostvars[host].seaweedfs_s3_secret_key }}"
        }
      ],
      "actions": [
        "Write:{{ offsite_backup_s3_bucket }}/{{ host }}-*",
        "Read:{{ offsite_backup_s3_bucket }}/{{ host }}-*",
        "List:{{ offsite_backup_s3_bucket }}/{{ host }}-*",
        "Tagging:{{ offsite_backup_s3_bucket }}/{{ host }}-*"
      ]
    }{{ "," if not loop.last else "" }}
{% endfor %}
  ]
}
