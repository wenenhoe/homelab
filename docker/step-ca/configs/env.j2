STEP_CA_NAME={{ lab_domain }}-internal-ca
# defaults.json's ca-url - and so the image's own HEALTHCHECK (`step ca
# health`) - is derived from the FIRST name below, so it must be one the
# container resolves to itself. Keep `step-ca` (this compose service's
# own name on caddy-proxy) first. See docs/step-ca.md.
STEP_CA_DNS_NAMES=step-ca,step-ca.{{ caddy_domain }}
STEP_CA_PASSWORD={{ step_ca_password }}
STEP_CA_PROVISIONER_PASSWORD={{ step_ca_provisioner_password }}
