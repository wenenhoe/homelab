<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{% block title %}wenenhoe&#39;s Homelab{% endblock %}</title>
<meta name="description" content="{{ description }}">
<meta property="og:title" content="{{ self.title() }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:site_name" content="wenenhoe&#39;s Homelab">
<link rel="stylesheet" href="{{ base }}{{ assets.simple_css }}" integrity="{{ sri }}">
<link rel="stylesheet" href="{{ base }}{{ assets.site_css }}">
<script>document.documentElement.classList.add('js')</script>
</head>
<body>
<header class="bar"><div class="bar-in">
<a class="brand" href="{{ home or './' }}">Homelab</a>
<nav aria-label="Views">{% for item in nav %}<a href="{{ item.href }}"{% if item.current %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}</nav>
<button class="menu-btn" type="button" aria-haspopup="dialog" aria-controls="drawer"><span aria-hidden="true">&#9776;</span> Menu</button>
</div></header>
<dialog class="drawer" id="drawer" aria-label="Menu"><div class="drawer-in">
<button class="close" type="button" aria-label="Close menu">&#10005;</button>
<h2>Views</h2>{% for item in nav %}<a href="{{ item.href }}"{% if item.current %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}
{% block drawer %}{% endblock %}</div></dialog>
<main>
{% block main %}{% endblock %}
</main>
<footer>
<p>Generated from the <a href="https://github.com/wenenhoe/homelab">homelab repository</a>'s documentation. {% if stamp %}Built from <a href="{{ stamp.url }}"><code>{{ stamp.short }}</code></a>, committed <time datetime="{{ stamp.date }}">{{ stamp.label }}</time>.{% else %}Local build.{% endif %}</p>
<p>Styled with <a href="https://simplecss.org/">Simple.css</a> under its <a href="{{ base }}assets/simple-licence.txt">MIT licence</a>.</p>
</footer>
<script src="{{ base }}{{ assets.site_js }}"></script>
</body>
</html>
