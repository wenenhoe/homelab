{% extends "base.html.j2" %}
{% block drawer %}{% if headings %}<h2>On this page</h2>{% for h in headings %}<a href="#{{ h.id }}"{% if h.level == 3 %} class="sub"{% endif %}>{{ h.text }}</a>{% endfor %}{% endif %}{% endblock %}
{% block main %}<h1 id="{{ title_id }}">{{ title }}</h1>
<article class="doc">
{{ body | safe }}</article>
<h2 id="explore">Explore the docs</h2>
<div class="home">{% for view in views %}<a class="tile" href="{{ view.href }}"><strong>{{ view.label }}</strong><span>{{ view.blurb }}</span></a>
{% endfor %}</div>
<p class="source">View on GitHub: {% for source, url in source_urls %}<a href="{{ url }}"><code>{{ source }}</code></a>{% if not loop.last %} · {% endif %}{% endfor %}</p>
{% endblock %}
