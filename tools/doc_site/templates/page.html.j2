{% extends "base.html.j2" %}
{% block title %}{{ title }} · {% endblock %}
{% block drawer %}<h2>On this page</h2>{% for h in headings %}<a href="#{{ h.id }}"{% if h.level == 3 %} class="sub"{% endif %}>{{ h.text }}</a>{% endfor %}{% endblock %}
{% block main %}<h1 id="{{ title_id }}">{{ title }}</h1>
{% for paragraph in intro %}<p class="lede">{{ paragraph | safe }}</p>
{% endfor %}<div class="filter"><input id="q" type="search" placeholder="Filter rows" aria-label="Filter rows"></div>
{% for section in sections %}<section id="{{ section.id }}"><h2>{{ section.title }}</h2>
{{ section.html | safe }}
</section>
{% endfor %}{% endblock %}
